{
  "name": "@network-compass/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "api-types": "openapi-ts",
    "api-types:check": "openapi-ts && git diff --exit-code -- lib/api/generated",
    "build": "next build",
    "dev": "next dev --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "graphology": "0.26.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sigma": "3.0.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
